rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PRODUCTION TENANT-AWARE ZERO-TRUST SECURITY HELPER FUNCTIONS
    // =========================================================================

    // 1. Authentication check: requires non-null authenticated principal
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getAuthUid() {
      return request.auth.uid;
    }

    // 2. Active Account Check: ensures suspended or disabled accounts cannot access data
    function isAccountActive() {
      return !('isAccountDisabled' in request.auth.token) || request.auth.token.isAccountDisabled != true;
    }

    // 3. Tenant matching check: validates tenantId in the document path matches
    // the authenticated caller's verified Firebase custom claims
    function hasMatchingTenant(tenantId) {
      return isAuthenticated() && isAccountActive() && (
        (('tenantId' in request.auth.token) && request.auth.token.tenantId == tenantId) ||
        (('institutionId' in request.auth.token) && request.auth.token.institutionId == tenantId) ||
        (('isSuperAdmin' in request.auth.token) && request.auth.token.isSuperAdmin == true)
      );
    }

    function getUserRole() {
      return ('role' in request.auth.token) ? request.auth.token.role : null;
    }

    function hasRole(role) {
      return isAuthenticated() && isAccountActive() && (
        getUserRole() == role ||
        getUserRole() == 'ROLE_' + role
      );
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && isAccountActive() && (
        getUserRole() in roles ||
        (('isSuperAdmin' in request.auth.token) && request.auth.token.isSuperAdmin == true)
      );
    }

    function isSelf(userId) {
      return isAuthenticated() && isAccountActive() && getAuthUid() == userId;
    }

    // Safe parent check: guards against missing, null, or invalid wardStudentIds claim
    function isParentOf(studentId) {
      return isAuthenticated() && isAccountActive() &&
        ('wardStudentIds' in request.auth.token) &&
        (request.auth.token.wardStudentIds is list) &&
        request.auth.token.wardStudentIds.hasAny([studentId]);
    }

    // Preserves tenant integrity: prevents tenantId tampering across create and update
    function preservesTenant(tenantId) {
      return (
        (('tenantId' in request.resource.data) ? request.resource.data.tenantId == tenantId : true) &&
        (('institutionId' in request.resource.data) ? request.resource.data.institutionId == tenantId : true) &&
        (resource == null ||
         (('tenantId' in resource.data) ? resource.data.tenantId == tenantId : true) &&
         (('institutionId' in resource.data) ? resource.data.institutionId == tenantId : true)
        )
      );
    }

    // =========================================================================
    // TENANT ROOT COLLECTION: /tenants/{tenantId}
    // =========================================================================

    match /tenants/{tenantId} {
      allow read: if hasMatchingTenant(tenantId);
      allow create, update, delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);

      // 1. Users & RBAC Identity
      match /users/{userId} {
        allow read: if hasMatchingTenant(tenantId);
        // Admin/Principal can create users; newly registering authenticated clients may only create their own profile with safe default STUDENT role
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          (isSelf(userId) && request.resource.data.role == 'STUDENT')
        );
        // Users cannot escalate their own role, tenant, permissions, or disabled state
        allow update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          (isSelf(userId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'role', 'permissions', 'tenantId', 'institutionId', 'isAccountDisabled', 'isSuperAdmin', 'claims'
           ]) &&
           request.resource.data.role == resource.data.role
          )
        );
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
      }

      // 2. Students & Scholar Records
      match /students/{studentId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          isSelf(studentId) ||
          isParentOf(studentId)
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'OFFICE', 'ROLE_OFFICE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
      }

      // 3. Faculty & Staff Records
      match /staff/{staffId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'STAFF_MANAGER', 'ROLE_STAFF_MANAGER']);
      }

      // 4. Classes & Academic Sections
      match /classes/{classId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      // 5. Attendance & Register Records
      match /attendance/{recordId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      // 6. Examinations & Report Cards
      match /exam_records/{examId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']) ||
          (resource.data.isPublished == true && (
            resource.data.studentId == getAuthUid() ||
            isParentOf(resource.data.studentId)
          ))
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      // 7. Fee Invoices & Financial Ledgers
      match /fee_invoices/{invoiceId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']);
      }

      // 8. Payment Transactions (Immutable, Server-Validated Ledger)
      match /payment_transactions/{transactionId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        // Clients CANNOT declare payment successful!
        // Only trusted backend Cloud Functions (isServerService == true) can record SUCCESS transactions.
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          (('isServerService' in request.auth.token) && request.auth.token.isServerService == true) ||
          (hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) && request.resource.data.status != 'SUCCESS')
        );
        allow update, delete: if false; // Strict immutability
      }

      // 9. Homework & Student Submissions
      match /homework/{homeworkId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);

        match /submissions/{submissionId} {
          allow read: if hasMatchingTenant(tenantId) && (
            hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER']) ||
            resource.data.studentId == getAuthUid() ||
            isParentOf(resource.data.studentId)
          );
          // Student can submit their own homework, status strictly initialized to SUBMITTED
          allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
            (hasAnyRole(['STUDENT', 'ROLE_STUDENT']) &&
             request.resource.data.studentId == getAuthUid() &&
             request.resource.data.status == 'SUBMITTED' &&
             !('grade' in request.resource.data) &&
             !('evaluationScore' in request.resource.data)
            ) ||
            hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'TEACHER', 'ROLE_TEACHER'])
          );
          // Teachers grade. Students can only update work if NOT evaluated and cannot change grading fields
          allow update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
            hasAnyRole(['TEACHER', 'ROLE_TEACHER', 'ADMIN', 'ROLE_ADMIN']) ||
            (isSelf(resource.data.studentId) &&
             request.resource.data.studentId == resource.data.studentId &&
             resource.data.status != 'EVALUATED' &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'grade', 'evaluatedBy', 'evaluationScore', 'status', 'evaluationRemarks', 'tenantId', 'institutionId'
             ])
            )
          );
          allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
        }
      }

      // 10. Library Catalog & Book Issues
      match /library_books/{bookId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /library_issues/{issueId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          resource.data.borrowerId == getAuthUid()
        );
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN']);
      }

      // 11. Transport Logistics
      match /transport_routes/{routeId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'TRANSPORT_STAFF', 'ROLE_TRANSPORT_STAFF', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      // 12. Immutable Audit Logs (Append-Only)
      match /audit_logs/{logId} {
        allow read: if hasMatchingTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']);
        // Append-only for verified operations matching caller identity
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          request.resource.data.actorUserId == getAuthUid() &&
          (
            (('tenantId' in request.resource.data) && request.resource.data.tenantId == tenantId) ||
            (('institutionId' in request.resource.data) && request.resource.data.institutionId == tenantId)
          ) &&
          (request.resource.data.actorRole == getUserRole() || request.resource.data.actorRole == 'ROLE_' + getUserRole());
        allow update, delete: if false; // Strict anti-tamper immutability
      }
    }

    // =========================================================================
    // INSTITUTIONS COMPATIBILITY PATH: /institutions/{tenantId}
    // Mirrors /tenants/{tenantId} for institutional SaaS schema compatibility
    // =========================================================================

    match /institutions/{tenantId} {
      allow read: if hasMatchingTenant(tenantId);
      allow create, update, delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);

      match /users/{userId} {
        allow read: if hasMatchingTenant(tenantId);
        // Admin/Principal can create users; newly registering authenticated clients may only create their own profile with safe default STUDENT role
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          (isSelf(userId) && request.resource.data.role == 'STUDENT')
        );
        allow update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          (isSelf(userId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'role', 'permissions', 'tenantId', 'institutionId', 'isAccountDisabled', 'isSuperAdmin', 'claims'
           ]) &&
           request.resource.data.role == resource.data.role
          )
        );
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
      }

      match /students/{studentId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          isSelf(studentId) ||
          isParentOf(studentId)
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'OFFICE', 'ROLE_OFFICE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
      }

      match /staff/{staffId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'STAFF_MANAGER', 'ROLE_STAFF_MANAGER']);
      }

      match /classes/{classId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /attendance/{recordId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /exam_records/{examId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']) ||
          (resource.data.isPublished == true && (
            resource.data.studentId == getAuthUid() ||
            isParentOf(resource.data.studentId)
          ))
        );
        allow create, update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);
        allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /fee_invoices/{invoiceId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']);
      }

      match /payment_transactions/{transactionId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) ||
          resource.data.studentId == getAuthUid() ||
          isParentOf(resource.data.studentId)
        );
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
          (('isServerService' in request.auth.token) && request.auth.token.isServerService == true) ||
          (hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']) && request.resource.data.status != 'SUCCESS')
        );
        allow update, delete: if false;
      }

      match /homework/{homeworkId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER', 'INCHARGE', 'ROLE_INCHARGE']);

        match /submissions/{submissionId} {
          allow read: if hasMatchingTenant(tenantId) && (
            hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'TEACHER', 'ROLE_TEACHER']) ||
            resource.data.studentId == getAuthUid() ||
            isParentOf(resource.data.studentId)
          );
          allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
            (hasAnyRole(['STUDENT', 'ROLE_STUDENT']) &&
             request.resource.data.studentId == getAuthUid() &&
             request.resource.data.status == 'SUBMITTED' &&
             !('grade' in request.resource.data) &&
             !('evaluationScore' in request.resource.data)
            ) ||
            hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'TEACHER', 'ROLE_TEACHER'])
          );
          allow update: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) && (
            hasAnyRole(['TEACHER', 'ROLE_TEACHER', 'ADMIN', 'ROLE_ADMIN']) ||
            (isSelf(resource.data.studentId) &&
             request.resource.data.studentId == resource.data.studentId &&
             resource.data.status != 'EVALUATED' &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'grade', 'evaluatedBy', 'evaluationScore', 'status', 'evaluationRemarks', 'tenantId', 'institutionId'
             ])
            )
          );
          allow delete: if hasMatchingTenant(tenantId) && hasAnyRole(['ADMIN', 'ROLE_ADMIN']);
        }
      }

      match /library_books/{bookId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /library_issues/{issueId} {
        allow read: if hasMatchingTenant(tenantId) && (
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN', 'PRINCIPAL', 'ROLE_PRINCIPAL']) ||
          resource.data.borrowerId == getAuthUid()
        );
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'LIBRARIAN', 'ROLE_LIBRARIAN']);
      }

      match /transport_routes/{routeId} {
        allow read: if hasMatchingTenant(tenantId);
        allow write: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'TRANSPORT_STAFF', 'ROLE_TRANSPORT_STAFF', 'PRINCIPAL', 'ROLE_PRINCIPAL']);
      }

      match /audit_logs/{logId} {
        allow read: if hasMatchingTenant(tenantId) &&
          hasAnyRole(['ADMIN', 'ROLE_ADMIN', 'PRINCIPAL', 'ROLE_PRINCIPAL', 'ACCOUNTANT', 'ROLE_ACCOUNTANT']);
        allow create: if hasMatchingTenant(tenantId) && preservesTenant(tenantId) &&
          request.resource.data.actorUserId == getAuthUid() &&
          (
            (('tenantId' in request.resource.data) && request.resource.data.tenantId == tenantId) ||
            (('institutionId' in request.resource.data) && request.resource.data.institutionId == tenantId)
          ) &&
          (request.resource.data.actorRole == getUserRole() || request.resource.data.actorRole == 'ROLE_' + getUserRole());
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // STRICT DEFAULT-DENY RULE
    // Every collection and path not explicitly permitted above is strictly denied
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
