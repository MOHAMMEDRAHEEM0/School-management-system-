<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicitly exclude sensitive student, attendance, and financial SQLite/Room data and session tokens -->
        <exclude domain="database" path="st_xaviers_sms_master.db" />
        <exclude domain="database" path="st_xaviers_sms_master.db-wal" />
        <exclude domain="database" path="st_xaviers_sms_master.db-shm" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="st_xaviers_sms_master.db" />
        <exclude domain="database" path="st_xaviers_sms_master.db-wal" />
        <exclude domain="database" path="st_xaviers_sms_master.db-shm" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
